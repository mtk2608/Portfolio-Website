---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import me from '../assets/Tayieb.jpeg';
import { SITE } from '../site';
import Timeline from '../components/Timeline.astro';

const certs = [
  { label: 'Foundational C# with Microsoft', href: 'https://www.freecodecamp.org/certification/MTKamaldien26/foundational-c-sharp-with-microsoft' },
  { label: 'Responsive Web Design', href: 'https://www.freecodecamp.org/certification/MTKamaldien26/responsive-web-design' },
  { label: 'Digital Marketing: Grow With Google' },
];
---
<Base title="About" description="About Mogamad Tayieb Kamaldien: background, education, experience and certificates.">
  <div class="grid gap-10 md:grid-cols-[18rem_1fr]">
    <aside>
      <Image src={me} alt="Portrait of Tayieb" width={500} class="aspect-square w-full rounded-3xl object-cover" />
      <p class="mt-4 font-display text-xl font-semibold">{SITE.name}</p>
      <p class="text-muted">{SITE.role} · {SITE.location}</p>
    </aside>
    <div>
      <h1 class="text-5xl font-semibold">About me</h1>
      <div class="prose-lite mt-6 max-w-2xl">
        <p>I'm a software developer who loves the hardest problems on the board. When a task is complex, unclear, or has stumped everyone else, that's usually the one I want. I enjoy taking something messy, breaking it into pieces, and working through it until it's solved and built properly.</p>
        <p>I care about writing code that lasts: clean, maintainable, and designed with the people who'll use and extend it in mind. I'm always picking up new tools, languages, and approaches, because I believe the best developers never stop learning. I like understanding how things work underneath, not just getting them to work.</p>
        <p>I'm a big believer in passing on what I know. The fastest way to grow is to help others grow with you, and I'm passionate about empowering people with the knowledge and confidence to tackle things they didn't think they could.</p>
        <p>Outside of code, I'm an amateur endurance athlete. Endurance sports taught me patience, discipline, and how to keep going when it gets hard, and those habits carry straight into my engineering work. I also love hustle culture, which keeps me close to the practical, real-world side of building things.</p>
      </div>

      <figure class="mt-8 max-w-2xl border-l-2 border-accent pl-5">
        <blockquote class="text-lg italic">“The impediment to action advances action. What stands in the way becomes the way.”</blockquote>
        <figcaption class="mt-2 text-sm text-muted">— Marcus Aurelius</figcaption>
      </figure>

      <h2 class="mt-12 text-2xl font-semibold">Experience</h2>
      <Timeline />

      <h2 class="mt-12 text-2xl font-semibold">Education</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="tile">
          <p class="font-semibold">Samsung Innovation Lab</p>
          <p class="text-sm text-muted">University of the Western Cape</p>
          <p class="mt-2 text-sm">Mobile Application Development · Digital Social Innovation</p>
        </div>
        <div class="tile">
          <p class="font-semibold">Northlink College</p>
          <p class="text-sm text-muted">Mechanical Engineering: N4 Fitting &amp; Machining</p>
          <p class="mt-2 text-sm">Engineering Science · Mathematics</p>
        </div>
      </div>

      <h2 class="mt-12 text-2xl font-semibold">Certificates</h2>
      <ul class="mt-4 space-y-2">
        {certs.map((c) => (
          <li>{c.href ? <a class="text-accent underline-offset-4 hover:underline" href={c.href} rel="noopener noreferrer">{c.label}</a> : c.label}</li>
        ))}
      </ul>
    </div>
  </div>
</Base>
