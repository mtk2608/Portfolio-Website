---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import me from '../assets/Tayieb.jpeg';
import { SITE } from '../site';
import Timeline from '../components/Timeline.astro';

const certs = [
  { label: 'Foundational C# with Microsoft', href: 'https://www.freecodecamp.org/certification/MTKamaldien26/foundational-c-sharp-with-microsoft' },
  { label: 'Responsive Web Design', href: 'https://www.freecodecamp.org/certification/MTKamaldien26/responsive-web-design' },
  { label: 'Digital Marketing: Grow With Google' },
];
---
<Base title="About" description="About Mogamad Tayieb Kamaldien: background, education, experience and certificates.">
  <div class="grid gap-10 md:grid-cols-[18rem_1fr]">
    <aside>
      <Image src={me} alt="Portrait of Tayieb" width={500} class="aspect-square w-full rounded-3xl object-cover" />
      <p class="mt-4 font-display text-xl font-semibold">{SITE.name}</p>
      <p class="text-muted">{SITE.role} · {SITE.location}</p>
    </aside>
    <div>
      <h1 class="text-5xl font-semibold">About me</h1>
      <div class="prose-lite mt-6 max-w-2xl">
        <p>Born in 2001 in Cape Town, South Africa, I'm a .NET mobile developer passionate about all things tech and lifelong learning.</p>
        <p>I thrive on challenging tasks that use frameworks and languages I'm not familiar with, as it forces me out of my comfort zone, where I believe 100% of learning takes place.</p>
        <p>I have an entrepreneurial spirit and a natural inclination toward identifying and pursuing business opportunities with the potential to grow and succeed.</p>
      </div>

      <h2 class="mt-12 text-2xl font-semibold">Experience</h2>
      <Timeline />

      <h2 class="mt-12 text-2xl font-semibold">Education</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="tile">
          <p class="font-semibold">Samsung Innovation Lab</p>
          <p class="text-sm text-muted">University of the Western Cape</p>
          <p class="mt-2 text-sm">Mobile Application Development · Digital Social Innovation</p>
        </div>
        <div class="tile">
          <p class="font-semibold">Northlink College</p>
          <p class="text-sm text-muted">Mechanical Engineering: N4 Fitting &amp; Machining</p>
          <p class="mt-2 text-sm">Engineering Science · Mathematics</p>
        </div>
      </div>

      <h2 class="mt-12 text-2xl font-semibold">Certificates</h2>
      <ul class="mt-4 space-y-2">
        {certs.map((c) => (
          <li>{c.href ? <a class="text-accent underline-offset-4 hover:underline" href={c.href} rel="noopener noreferrer">{c.label}</a> : c.label}</li>
        ))}
      </ul>
    </div>
  </div>
</Base>
