---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const fmt = (d: Date) => d.toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="Blog" description="Notes on mobile development, learning and life.">
  <h1 class="text-5xl font-semibold">Blog</h1>
  <p class="mt-3 max-w-xl text-muted">Notes on development, learning in public, and life.</p>
  <ul class="mt-10 divide-y divide-line border-y border-line">
    {posts.map((p) => (
      <li>
        <a href={`/blog/${p.id}`} class="group flex flex-col gap-1 py-6 sm:flex-row sm:items-baseline sm:justify-between">
          <div>
            <h2 class="text-2xl font-semibold transition group-hover:text-accent">{p.data.title}</h2>
            <p class="mt-1 text-muted">{p.data.description}</p>
          </div>
          <time class="shrink-0 text-sm text-muted" datetime={p.data.date.toISOString()}>{fmt(p.data.date)}</time>
        </a>
      </li>
    ))}
  </ul>
</Base>
