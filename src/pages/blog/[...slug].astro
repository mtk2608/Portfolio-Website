---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(p);
const date = p.data.date.toLocaleDateString('en-ZA', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title={p.data.title} description={p.data.description}>
  <a href="/" class="text-sm text-muted hover:text-ink">← Back home</a>
  <h1 class="mt-4 max-w-3xl text-4xl font-semibold leading-tight sm:text-5xl">{p.data.title}</h1>
  <div class="mt-4 flex flex-wrap items-center gap-2 text-sm text-muted">
    <time datetime={p.data.date.toISOString()}>{date}</time>
    {p.data.tags.map((t) => <span class="chip">#{t}</span>)}
  </div>
  <article class="prose-lite mt-10 max-w-2xl"><Content /></article>
</Base>
