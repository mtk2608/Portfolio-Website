---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Projects" description="Personal projects by Tayieb.">
  <h1 class="text-5xl font-semibold">Projects</h1>
  <p class="mt-3 max-w-xl text-muted">Things I build to learn, scratch an itch, or just for fun.</p>
  <ul class="mt-10 grid gap-4 md:grid-cols-2">
    {projects.map((p) => (
      <li>
        <a href={`/projects/${p.id}`} class="tile flex h-full flex-col">
          <div class="flex items-start justify-between gap-4">
            <div>
              <span class="chip mb-3">{p.data.status}</span>
              <h2 class="text-2xl font-semibold">{p.data.title}</h2>
            </div>
            {p.data.cover && <Image src={p.data.cover} alt="" width={96} class="h-20 w-20 object-contain" />}
          </div>
          <p class="mt-3 text-muted">{p.data.summary}</p>
          <div class="mt-auto flex flex-wrap gap-2 pt-5">{p.data.stack.map((s) => <span class="chip">{s}</span>)}</div>
        </a>
      </li>
    ))}
    <li class="tile grid place-items-center border-dashed text-muted">More coming soon…</li>
  </ul>
</Base>
