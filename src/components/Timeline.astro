---
import { EXPERIENCE, ROLES } from '../experience';
---
<ol class="relative mt-8 space-y-12 border-l border-line pl-8" id="timeline">
  {EXPERIENCE.map((c) => (
    <li class="relative" data-company={c.id}>
      <span class="absolute -left-[2.5rem] top-1 h-4 w-4 rounded-full border-2 border-accent bg-bg" aria-hidden="true"></span>
      <p class="text-xs uppercase tracking-widest text-accent">{c.period} · {c.duration}</p>
      <h3 class="mt-1 text-2xl font-semibold">{c.name}</h3>
      <p class="text-sm text-muted">{c.location}</p>

      <ol class="mt-6 space-y-7 border-l border-dashed border-line pl-8">
        {c.roles.map((r) => (
          <li class="relative" data-role={r.id}>
            <button
              type="button"
              data-open={r.id}
              aria-haspopup="dialog"
              aria-label={`Read more: ${r.title}, ${c.name}`}
              class="absolute -left-[2.5rem] top-1 h-4 w-4 cursor-pointer rounded-full border-2 border-line bg-surface transition before:absolute before:-inset-2.5 before:content-[''] hover:scale-125 hover:border-accent hover:bg-accent"
            ></button>
            <p class="text-xs uppercase tracking-widest text-muted">{r.period}</p>
            <h4 class="mt-1 text-lg font-semibold">{r.title}</h4>
            <p class="text-sm text-muted">{[r.unit, r.type].filter(Boolean).join(' · ')}</p>
            <p class="mt-2 max-w-xl text-muted">{r.summary}</p>
            <button type="button" data-open={r.id} class="mt-2 cursor-pointer text-sm text-accent hover:underline">Read more →</button>
          </li>
        ))}
      </ol>
    </li>
  ))}
</ol>

{ROLES.map((r) => (
  <dialog id={`role-${r.id}`} aria-labelledby={`role-${r.id}-t`} class="role-dialog m-auto w-[min(92vw,38rem)] rounded-3xl border border-line bg-surface p-0 text-ink">
    <div class="p-6 sm:p-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-xs uppercase tracking-widest text-accent">{r.period}</p>
          <h3 id={`role-${r.id}-t`} class="mt-1 text-2xl font-semibold">{r.title}</h3>
          <p class="text-sm text-muted">{[r.company, r.unit, r.type].filter(Boolean).join(' · ')}</p>
        </div>
        <button type="button" data-close class="grid h-9 w-9 shrink-0 cursor-pointer place-items-center rounded-full border border-line hover:border-accent" aria-label="Close">✕</button>
      </div>
      <ul class="prose-lite mt-5 list-disc pl-5">
        {r.details.map((d) => <li>{d}</li>)}
      </ul>
      <div class="mt-5 flex flex-wrap gap-2">{r.skills.map((s) => <span class="chip">{s}</span>)}</div>
    </div>
  </dialog>
))}

<style is:global>
  .role-dialog::backdrop { background: rgb(0 0 0 / 0.7); backdrop-filter: blur(4px); }
  .role-dialog[open] { animation: pop .2s ease-out; }
  @keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.98); } }
</style>

<script is:inline src="/timeline.js" defer></script>
