---
import '../styles/global.css';
import { SITE, NAV } from '../site';
import { SITE_NOINDEX } from 'astro:env/server';

interface Props { title?: string; description?: string }
const { title, description = SITE.description } = Astro.props;
const full = title ? `${title} · ${SITE.short}` : SITE.name;
const path = Astro.url.pathname;
// On detail pages (/projects/x, /blog/x) highlight the matching nav item.
// On the landing page, /nav.js scroll-spy sets aria-current as sections come into view.
const isActive = (match?: string) => !!match && (path === match || path.startsWith(match + '/'));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    {SITE_NOINDEX && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog" href="/rss.xml" />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-black">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-line/60 bg-bg/80 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-5 py-3 sm:py-4" aria-label="Main">
        <a href="/" aria-label={`${SITE.alias.main}${SITE.alias.accent} home`} class="font-display text-lg font-semibold">{SITE.alias.main}<span class="text-accent">{SITE.alias.accent}</span></a>
        <ul class="no-scrollbar -mx-2 flex w-full items-center gap-0.5 overflow-x-auto px-2 text-sm sm:mx-0 sm:w-auto sm:gap-1 sm:overflow-visible sm:px-0">
          {NAV.map((n) => (
            <li>
              <a
                href={n.href}
                data-section={n.section}
                aria-current={isActive(n.match) ? 'page' : undefined}
                class="block whitespace-nowrap rounded-full px-2.5 py-1.5 text-muted transition sm:px-3 hover:text-ink aria-[current]:bg-surface-2 aria-[current]:text-ink"
              >{n.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-5 py-8 sm:py-10"><slot /></main>
    <footer class="mx-auto max-w-6xl border-t border-line/60 px-5 py-8 text-sm text-muted">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p>© {new Date().getFullYear()} {SITE.name} · {SITE.location}</p>
        <div class="flex gap-5">
          <a class="hover:text-ink" href={SITE.github} rel="noopener noreferrer">GitHub</a>
          <a class="hover:text-ink" href={`mailto:${SITE.email}`}>Email</a>
          <a class="hover:text-ink" href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>
    <script is:inline src="/nav.js" defer></script>
  </body>
</html>
