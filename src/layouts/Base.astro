---
import '../styles/global.css';
import { SITE, NAV } from '../site';

interface Props { title?: string; description?: string }
const { title, description = SITE.description } = Astro.props;
const full = title ? `${title} · ${SITE.short}` : SITE.name;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={full} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Blog" href="/rss.xml" />
  </head>
  <body class="min-h-screen">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-black">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-line/60 bg-bg/80 backdrop-blur">
      <nav class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4" aria-label="Main">
        <a href="/" class="font-display text-lg font-semibold">{SITE.short}<span class="text-accent">.</span></a>
        <ul class="flex items-center gap-1 text-sm">
          {NAV.map((n) => (
            <li>
              <a
                href={n.href}
                aria-current={isActive(n.href) ? 'page' : undefined}
                class:list={['rounded-full px-3 py-1.5 transition hover:text-ink', isActive(n.href) ? 'bg-surface-2 text-ink' : 'text-muted']}
              >{n.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main id="main" class="mx-auto max-w-6xl px-5 py-10"><slot /></main>
    <footer class="mx-auto max-w-6xl border-t border-line/60 px-5 py-8 text-sm text-muted">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <p>© {new Date().getFullYear()} {SITE.name} · {SITE.location}</p>
        <div class="flex gap-5">
          <a class="hover:text-ink" href={SITE.github} rel="noopener noreferrer">GitHub</a>
          <a class="hover:text-ink" href={`mailto:${SITE.email}`}>Email</a>
          <a class="hover:text-ink" href="/rss.xml">RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>
